# Copy to .env and fill in. Never commit .env.

# Agent
OPENAI_API_KEY=
# Validated model (see eval/README.md). Change it only after an evaluation run.
OPENAI_MODEL=gpt-4.1

# Planner: Jinko (keys: https://dashboard.gojinko.com/developers/keys). Our key works on the
# production host; override with JINKO_BASE_URL if needed. Search only: nothing is booked.
JINKO_API_KEY=
JINKO_MODE=replay   # replay (cache only) or live

# Optional: Pipelex (T10 spike)
PIPELEX_GATEWAY_API_KEY=
