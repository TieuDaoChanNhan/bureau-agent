# Copy to .env and fill in. Never commit .env.

# Agent. No key? Set DEMO_MODE=1 below: the console then replays saved examples.
OPENAI_API_KEY=
# Validated model (see eval/README.md). Change it only after an evaluation run.
OPENAI_MODEL=gpt-4.1

# Public demo: isolated browser sessions and bounded live calls with replay.
# Render enables this; leave disabled for the existing CLI/development workflow.
DEMO_MODE=0
DEMO_DAILY_LLM_LIMIT=400
DEMO_SESSION_LLM_LIMIT=60
DEMO_MAX_OUTPUT_TOKENS=2048

# Planner: Jinko (keys: https://dashboard.gojinko.com/developers/keys). Our key works on the
# production host; override with JINKO_BASE_URL if needed. Search only: nothing is booked.
JINKO_API_KEY=
JINKO_MODE=replay   # replay (cache only) or live

