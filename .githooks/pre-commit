#!/bin/sh
# Run the test suite before each commit. Enable once with: git config core.hooksPath .githooks
# Skip in an emergency with: git commit --no-verify
PY=python
command -v "$PY" >/dev/null 2>&1 || PY=python3
PYTHONIOENCODING=utf-8 "$PY" -m unittest discover -s tests -t . -q || {
  echo "Tests failed: commit aborted (use --no-verify to skip)."; exit 1; }
